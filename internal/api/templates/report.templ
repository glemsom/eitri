package templates

import (
	"encoding/json"
	"fmt"
	"strconv"
	"strings"
	"time"

	"github.com/glemsom/eitri/internal/debug"
	"github.com/glemsom/eitri/internal/report"
	"github.com/glemsom/eitri/internal/session"
)

// TurnView holds pre-rendered HTML for a report turn, so the template
// doesn't need to import the api package's markdown renderer.
type TurnView struct {
	Turn             int
	Role             string
	ContentHTML      string // pre-rendered Markdown → HTML
	ReasoningHTML    string // pre-rendered Markdown → HTML
	Timestamp        time.Time
	LLMDurationMs    int64
	LLMTraceID       string
	LLMRequestBytes  int
	LLMResponseBytes int
	LLMTTFBMs        int64
	LLMTTFTMs        int64
	LLMAttempt       int
	LLMAttemptCount  int
	LLMFailedAttempts int
	LLMModel         string
	LLMFinishReason  string
	LLMUsage         *debug.UsageTotals
	ContextBefore    *report.ContextInfo
	ContextAfter     *report.ContextInfo
	ToolCalls        []report.ToolCallInfo
}

// ReportPage renders the full Session Report page.
templ ReportPage(sessions []*session.UISession, activeID string, sess *session.UISession, workspace string, currentPath string, contextWindow int, reasoningContent string, compactionEnabled bool, contextWarningThreshold int, rep *report.SessionReport, runs []report.RunInfo, selectedRun int, turnViews []TurnView) {
	@Base("Eitri — Report", currentPath, sessions, activeID, currentPath, workspace, contextWindow, reasoningContent, compactionEnabled, contextWarningThreshold) {
		if rep == nil {
			<div id="report-view" class="report-view">
				<div class="report-not-found">
					<h2>Session data not found</h2>
					<p>The session data for this report could not be found on disk.</p>
					<a href={ templ.URL("/sessions/" + activeID) } class="btn-primary">Back to chat</a>
				</div>
			</div>
		} else {
			<div id="report-view" class="report-view">
				@ReportHeader(rep, activeID)
				@RunSelector(runs, sessionIDFromReport(rep), selectedRun)
				@ReportTimeline(turnViews)
				@ReportSubAgents(rep)
			</div>
		}
	}
}

// sessionIDFromReport returns the session ID from the report.
func sessionIDFromReport(rep *report.SessionReport) string {
	if rep == nil {
		return ""
	}
	return rep.SessionID
}

// ReportHeader renders the summary strip at the top of the report.
templ ReportHeader(rep *report.SessionReport, sessionID string) {
	<div class="report-header">
		<div class="report-header-top">
			<h2 class="report-title">
				<span class="report-title-text">{ rep.Title }</span>
				<a href={ templ.URL("/sessions/" + sessionID) } class="report-back-link" title="Back to chat">← Back to chat</a>
			</h2>
		</div>
		if rep.SystemPrompt != "" {
			<details class="report-system-prompt">
				<summary>System Prompt</summary>
				<pre class="report-system-prompt-content">{ rep.SystemPrompt }</pre>
			</details>
		}
		<div class="report-header-meta">
			<div class="report-meta-item">
				<span class="report-meta-label">Model</span>
				<span class="report-meta-value">{ rep.Model }</span>
			</div>
			<div class="report-meta-item">
				<span class="report-meta-label">Provider</span>
				<span class="report-meta-value">{ rep.Provider }</span>
			</div>
			<div class="report-meta-item">
				<span class="report-meta-label">Workspace</span>
				<span class="report-meta-value report-workspace-path" title={ rep.Workspace }>{ shortWorkspacePath(rep.Workspace) }</span>
			</div>
			<div class="report-meta-item">
				<span class="report-meta-label">Turns</span>
				<span class="report-meta-value">{ strconv.Itoa(rep.Summary.TotalTurns) }</span>
			</div>
			<div class="report-meta-item">
				<span class="report-meta-label">Tool calls</span>
				<span class="report-meta-value">{ strconv.Itoa(rep.Summary.TotalToolCalls) }</span>
			</div>
			<div class="report-meta-item">
				<span class="report-meta-label">Failed tools</span>
				if rep.Summary.FailedToolCalls > 0 {
					<span class="report-meta-value report-meta-badge-error">{ strconv.Itoa(rep.Summary.FailedToolCalls) }</span>
				} else {
					<span class="report-meta-value">0</span>
				}
			</div>
			<div class="report-meta-item">
				<span class="report-meta-label">Estimated tokens</span>
				<span class="report-meta-value">{ formatNumber(rep.Summary.EstimatedTotalTokens) }</span>
			</div>
			if rep.Summary.TotalRetries > 0 {
				<div class="report-meta-item">
					<span class="report-meta-label">Retries</span>
					<span class="report-meta-value">{ strconv.Itoa(rep.Summary.TotalRetries) }</span>
				</div>
			}
			if rep.Summary.TotalCacheReadTokens > 0 || rep.Summary.TotalCacheWriteTokens > 0 {
				<div class="report-meta-item">
					<span class="report-meta-label">Cache tokens</span>
					<span class="report-meta-value">{ cacheSummary(rep.Summary) }</span>
				</div>
			}
			<div class="report-meta-item">
				<span class="report-meta-label">Duration</span>
				<span class="report-meta-value">{ formatDuration(rep.DurationMs) }</span>
			</div>
			<div class="report-meta-item">
				<span class="report-meta-label">Status</span>
				<span class="report-meta-value">
					@TerminationChip(rep.Termination)
				</span>
			</div>
			if rep.ReportVersion == "reconstructed" {
				<div class="report-version-notice">⚠ Limited data — no timeline persisted for this session</div>
			}
		</div>
	</div>
}

// TerminationChip renders a badge showing how the run ended.
templ TerminationChip(t *report.TerminationInfo) {
	if t != nil {
		switch t.Reason {
		case "completed":
			<span class="termination-chip termination-completed" title={ t.Message }>✅ Completed</span>
		case "max_turns":
			<span class="termination-chip termination-max-turns" title={ t.Message }>⛔ Max turns</span>
		case "cancelled":
			<span class="termination-chip termination-cancelled" title={ t.Message }>🚫 Cancelled</span>
		case "error":
			<span class="termination-chip termination-error" title={ t.Message }>⚠️ Error</span>
		default:
			<span class="termination-chip" title={ t.Message }>{ t.Reason }</span>
		}
	} else {
		<span class="termination-chip">—</span>
	}
}

// RunSelector renders a dropdown to switch between runs.
templ RunSelector(runs []report.RunInfo, sessionID string, selectedRun int) {
	if len(runs) > 1 {
		<div class="report-run-selector">
			<label for="run-select">Run:</label>
			<select
				id="run-select"
				class="run-select"
				name="run"
				hx-get={ "/api/report/" + sessionID + "/fragment" }
				hx-target="#report-timeline"
				hx-trigger="change"
				hx-swap="innerHTML"
				hx-vals="js:{run: document.getElementById('run-select').value}"
			>
				for i, r := range runs {
					<option value={ strconv.Itoa(r.Run) } selected={ i == selectedRun }>
						{ "Run #" + strconv.Itoa(r.Run+1) + " — " + strconv.Itoa(r.Turns) + " turns — " + string(r.Termination.Reason) }
					</option>
				}
			</select>
		</div>
	}
}

// ReportTimeline renders the scrollable vertical list of turn cards.
templ ReportTimeline(turnViews []TurnView) {
	<div id="report-timeline" class="report-timeline">
		for _, turn := range turnViews {
			@TurnCard(turn)
		}
	</div>
}

// TurnCard renders a single turn in the timeline.
templ TurnCard(turn TurnView) {
	<div class={ "turn-card", templ.KV("turn-user", turn.Role == "user"), templ.KV("turn-assistant", turn.Role == "assistant") }>
		if turn.Role == "user" {
			<div class="turn-header">
				<span class="turn-role-icon">👤</span>
				<span class="turn-role-label">User</span>
				<span class="turn-timestamp">{ turn.Timestamp.Format("15:04:05") }</span>
				<span class="turn-number">Turn #{ strconv.Itoa(turn.Turn) }</span>
			</div>
			<div class="turn-content turn-user-content">
				@templ.Raw(turn.ContentHTML)
			</div>
		} else if turn.Role == "assistant" {
			<div class="turn-header">
				<span class="turn-role-icon">🤖</span>
				<span class="turn-role-label">Assistant</span>
				<span class="turn-timestamp">{ turn.Timestamp.Format("15:04:05") }</span>
				<span class="turn-number">Turn #{ strconv.Itoa(turn.Turn) }</span>
			</div>
			if turn.LLMDurationMs > 0 || turn.LLMTraceID != "" || turn.LLMRequestBytes > 0 || turn.LLMResponseBytes > 0 || turn.LLMTTFBMs > 0 || turn.LLMTTFTMs > 0 || turn.LLMAttemptCount > 0 || turn.LLMAttempt > 0 || turn.LLMModel != "" || turn.LLMFinishReason != "" || turn.LLMUsage != nil {
				<div class="turn-llm-meta">
					if turn.LLMDurationMs > 0 {
						<span class="llm-meta-item">⏱ { formatDurationSmall(turn.LLMDurationMs) }</span>
					}
					if turn.LLMTTFBMs > 0 {
						<span class="llm-meta-item" title="Time to first byte">⚡ { formatDurationSmall(turn.LLMTTFBMs) }</span>
					}
					if turn.LLMTTFTMs > 0 {
						<span class="llm-meta-item" title="Time to first token">✍️ { formatDurationSmall(turn.LLMTTFTMs) }</span>
					}
					if turn.LLMRequestBytes > 0 {
						<span class="llm-meta-item">↑ { formatBytes(turn.LLMRequestBytes) }</span>
					}
					if turn.LLMResponseBytes > 0 {
						<span class="llm-meta-item">↓ { formatBytes(turn.LLMResponseBytes) }</span>
					}
					if turn.LLMUsage != nil && turn.LLMUsage.PromptTokens > 0 && turn.LLMUsage.CompletionTokens > 0 {
						<span class="llm-meta-item" title="Provider-reported tokens: prompt + completion{ cacheTokenSuffix(turn.LLMUsage) }">🧮 { formatNumber(turn.LLMUsage.PromptTokens) } + { formatNumber(turn.LLMUsage.CompletionTokens) } tok</span>
					}
					if turn.LLMFinishReason != "" {
						<span class="llm-meta-item" title="Finish reason">🏁 { turn.LLMFinishReason }</span>
					}
					if turn.LLMModel != "" {
						<span class="llm-meta-item" title="Model">🤖 { turn.LLMModel }</span>
					}
					if turn.LLMAttemptCount > 0 {
						<span class="llm-meta-item" title="Total LLM call attempts and retries before success">🔁 { strconv.Itoa(turn.LLMAttemptCount) } attempts ({ retryLabel(turn.LLMFailedAttempts) })</span>
					} else if turn.LLMAttempt > 0 {
						<span class="llm-meta-item" title="Retry attempt">🔁 attempt { strconv.Itoa(turn.LLMAttempt + 1) }</span>
					}
					if turn.LLMTraceID != "" {
						<span class="llm-meta-item">
							<a href={ templ.URL("/api/debug/http/" + turn.LLMTraceID) } class="trace-link" title="View HTTP trace">🔍 Trace</a>
						</span>
					}
				</div>
			}
			<div class="turn-content turn-assistant-content">
				@templ.Raw(turn.ContentHTML)
			</div>
			if turn.ReasoningHTML != "" {
				<details class="turn-reasoning">
					<summary>Reasoning</summary>
					<div class="turn-reasoning-content">@templ.Raw(turn.ReasoningHTML)</div>
				</details>
			}
			@ContextBar(turn.ContextBefore, turn.ContextAfter)
			if len(turn.ToolCalls) > 0 {
				<div class="turn-tool-calls">
					for _, tc := range turn.ToolCalls {
						@ToolCallCard(tc)
					}
				</div>
			}
			}
		</div>
	}

// ContextBar renders a thin progress bar showing token usage vs context window.
templ ContextBar(before *report.ContextInfo, after *report.ContextInfo) {
	if before != nil || after != nil {
		<div class="turn-context-bar">
			if before != nil {
				<div class="context-bar-segment">
					<span class="context-bar-label">Before</span>
					<div class="context-bar-track">
						<div
							class="context-bar-fill"
							style={ "width:" + strconv.Itoa(contextPercent(before)) + "%" }
							title={ strconv.Itoa(before.TotalTokens) + " / " + strconv.Itoa(before.ContextWindow) + " tokens" }
						></div>
					</div>
					<span class="context-bar-value">{ strconv.Itoa(before.TotalTokens) }</span>
				</div>
			}
			if after != nil {
				<div class="context-bar-segment">
					<span class="context-bar-label">After</span>
					<div class="context-bar-track">
						<div
							class="context-bar-fill"
							style={ "width:" + strconv.Itoa(contextPercent(after)) + "%" }
							title={ strconv.Itoa(after.TotalTokens) + " / " + strconv.Itoa(after.ContextWindow) + " tokens" }
						></div>
					</div>
					<span class="context-bar-value">{ strconv.Itoa(after.TotalTokens) }</span>
				</div>
			}
		</div>
	}
}

// ToolCallCard renders one tool call in a collapsible card.
templ ToolCallCard(tc report.ToolCallInfo) {
	<div class={ "tool-call-card", templ.KV("tool-call-error", tc.Error) }>
		<details class="tool-call-details">
			<summary class="tool-call-summary">
				<span class="tool-call-name">{ tc.Name }</span>
				if tc.Error {
					<span class="tool-call-badge tool-call-badge-error">❌</span>
				} else {
					<span class="tool-call-badge tool-call-badge-success">✅</span>
				}
				if tc.DurationMs > 0 {
					<span class="tool-call-duration">{ formatDurationSmall(tc.DurationMs) }</span>
				}
			</summary>
			<div class="tool-call-body">
				<div class="tool-call-section">
					<span class="tool-call-section-label">Arguments</span>
					<div class="tool-call-args">
						<pre><code class="language-json">{ renderJSON(tc.Arguments) }</code></pre>
					</div>
				</div>
				<div class="tool-call-section">
					<span class="tool-call-section-label">Result</span>
					<div class="tool-call-result">
						if tc.ResultTruncated {
							<details class="tool-call-result-toggle">
								<summary>Preview (truncated)</summary>
								<pre><code>{ tc.ResultPreview }</code></pre>
							</details>
						} else {
							<pre><code>{ tc.ResultPreview }</code></pre>
						}
					</div>
				</div>
			</div>
		</details>
	</div>
}

// ReportSubAgents renders links to child session reports.
templ ReportSubAgents(rep *report.SessionReport) {
	if len(rep.SubAgents) > 0 {
		<div class="report-sub-agents">
			<h3>Sub-agents</h3>
			<ul class="sub-agent-list">
				for _, childID := range rep.SubAgents {
					<li class="sub-agent-item">
						<span class="sub-agent-id">{ childID }</span>
						<a href={ templ.URL("/report/" + childID) } class="sub-agent-link">📊 Report</a>
					</li>
				}
			</ul>
		</div>
	}
}

// ReportNotFound renders the "not found" message for HTMX fragment swaps.
templ ReportNotFound() {
	<div class="report-timeline-empty">
		<p>Session data not found</p>
	</div>
}

// helpers

func formatNumber(n int) string {
	if n >= 1000000 {
		return strconv.Itoa(n/1000000) + "M"
	}
	if n >= 1000 {
		return strconv.Itoa(n/1000) + "K"
	}
	return strconv.Itoa(n)
}

func formatDuration(ms int64) string {
	if ms == 0 {
		return "—"
	}
	d := time.Duration(ms) * time.Millisecond
	if d >= time.Hour {
		return d.Round(time.Minute).String()
	}
	if d >= time.Minute {
		return d.Round(time.Second).String()
	}
	return d.Round(time.Millisecond).String()
}

func formatDurationSmall(ms int64) string {
	if ms == 0 {
		return "—"
	}
	if ms < 1000 {
		return strconv.FormatInt(ms, 10) + "ms"
	}
	return fmt.Sprintf("%.1fs", float64(ms)/1000.0)
}

func formatBytes(b int) string {
	if b < 1024 {
		return strconv.Itoa(b) + "B"
	}
	if b < 1024*1024 {
		return strconv.Itoa(b/1024) + "KB"
	}
	return fmt.Sprintf("%.1fMB", float64(b)/(1024.0*1024.0))
}

// retryLabel renders the retry badge text for a turn, e.g. "1 retry" or "2 retries".
func retryLabel(failed int) string {
	if failed == 1 {
		return "1 retry"
	}
	return strconv.Itoa(failed) + " retries"
}

// cacheTokenSuffix returns a human-readable suffix describing the provider's
// cache-read/cache-creation token counts, or "" when neither is reported.
func cacheTokenSuffix(u *debug.UsageTotals) string {
	if u == nil {
		return ""
	}
	var parts []string
	if u.CacheReadTokens > 0 {
		parts = append(parts, fmt.Sprintf("%d cache read", u.CacheReadTokens))
	}
	if u.CacheWriteTokens > 0 {
		parts = append(parts, fmt.Sprintf("%d cache created", u.CacheWriteTokens))
	}
	if len(parts) == 0 {
		return ""
	}
	return " · " + strings.Join(parts, ", ")
}

// cacheSummary renders the aggregate cache token counts for a run summary.
func cacheSummary(s report.Summary) string {
	var parts []string
	if s.TotalCacheReadTokens > 0 {
		parts = append(parts, formatNumber(s.TotalCacheReadTokens)+" read")
	}
	if s.TotalCacheWriteTokens > 0 {
		parts = append(parts, formatNumber(s.TotalCacheWriteTokens)+" created")
	}
	return strings.Join(parts, " / ")
}

func contextPercent(ci *report.ContextInfo) int {
	if ci == nil || ci.ContextWindow == 0 {
		return 0
	}
	pct := ci.TotalTokens * 100 / ci.ContextWindow
	if pct > 100 {
		pct = 100
	}
	return pct
}

func renderJSON(v any) string {
	if v == nil {
		return "null"
	}
	b, err := json.MarshalIndent(v, "", "  ")
	if err != nil {
		return fmt.Sprintf("error: %v", err)
	}
	return string(b)
}
