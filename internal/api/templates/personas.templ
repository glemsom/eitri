package templates

import (
	"fmt"

	"github.com/glemsom/eitri/internal/persona"
	"github.com/glemsom/eitri/internal/skills"
)

// PersonaList renders the persona list as an HTML fragment for HTMX.
templ PersonaList(personas []*persona.PersonaDefinition, activePersona string) {
	for _, p := range personas {
		<div class="persona-card" id={ "persona-" + p.Name }>
			<div class="persona-card-header">
				<span class="persona-name">{ p.Name }</span>
				if p.Name == activePersona {
					<span class="persona-active-badge">Active</span>
				}
				if p.Name == "generic" {
					<span class="persona-builtin-badge">Built-in</span>
				}
				<div class="persona-actions">
					if p.Name != "generic" {
						<button type="button" class="btn btn-sm"
							hx-get={ "/api/personas/" + p.Name }
							hx-trigger="click"
							hx-target={ "#edit-form-" + p.Name }
							hx-swap="innerHTML"
							hx-indicator={ "#indicator-" + p.Name }>
							Edit
						</button>
						<button type="button" class="btn btn-sm btn-danger"
							hx-delete={ "/api/personas/" + p.Name }
							hx-target="#persona-list"
							hx-swap="innerHTML"
							hx-confirm={ fmt.Sprintf("Delete persona %q?", p.Name) }>
							Delete
						</button>
					}
				</div>
			</div>
			<p class="persona-prompt-preview">{ previewPrompt(p.SystemPrompt) }</p>
			<div id={ "edit-form-" + p.Name }></div>
			<span id={ "indicator-" + p.Name } class="htmx-indicator">Loading…</span>
		</div>
	}
	if len(personas) == 0 {
		<p class="text-muted">No personas found. The built-in "generic" persona will be created automatically.</p>
	}
}

// PersonaAddForm renders the inline "Add Persona" form.
// It POSTs to /api/personas with form-encoded data.
// availableSkills is the list of all discoverable skill names.
templ PersonaAddForm(availableSkills []*skills.Skill) {
	<div class="persona-form" id="persona-add-form">
		<h4>Add Persona</h4>
		<div class="form-group">
			<label for="name">Name</label>
			<input type="text" id="name" name="name" placeholder="my-custom-agent" required/>
			<small class="hint">Unique identifier for this persona.</small>
		</div>
		<div class="form-group">
			<label for="system_prompt">System Prompt</label>
			<textarea id="system_prompt" name="system_prompt" class="monospace-textarea" rows="6" placeholder="You are a specialized agent that..."></textarea>
			<small class="hint">Leave empty to use the default system prompt.</small>
		</div>
		<div class="form-group">
			<label>Injected Skills</label>
			<small class="hint">Skills selected here are automatically loaded into the system prompt when this persona is active.</small>
			<div class="skills-checkbox-group">
				for _, s := range availableSkills {
					<label class="checkbox-label">
						<input type="checkbox" name="injected_skills" value={ s.Name }/>
						<span class="skill-name">{ s.Name }</span>
						if s.Description != "" {
							<span class="skill-desc"> — { s.Description }</span>
						}
					</label>
				}
			</div>
		</div>
		<div class="form-actions">
			<button type="button" class="btn btn-primary"
				hx-post="/api/personas"
				hx-target="#persona-list"
				hx-swap="innerHTML"
				hx-include="#persona-add-form"
				hx-indicator="#add-indicator"
				hx-on::after-request="if(event.detail.successful && !event.detail.xhr.responseText.includes('error')){ document.getElementById('persona-add-form').remove(); }">
				Create
			</button>
			<button type="button" class="btn btn-secondary" onclick="document.getElementById('persona-add-form')?.remove()">Cancel</button>
			<span id="add-indicator" class="htmx-indicator">Saving…</span>
		</div>
		<div id="persona-form-errors" class="form-error" hx-swap-oob="true"></div>
	</div>
}

// PersonaEditForm renders the inline "Edit Persona" form.
// It PUTs to /api/personas/{name} with form-encoded data.
// availableSkills is the list of all discoverable skill names.
templ PersonaEditForm(p *persona.PersonaDefinition, availableSkills []*skills.Skill) {
	<form class="persona-form" id={ "edit-form-" + p.Name }
		hx-put={ "/api/personas/" + p.Name }
		hx-target="#persona-list"
		hx-swap="innerHTML"
		hx-indicator={ "#edit-indicator-" + p.Name }>
		<h4>Edit Persona: { p.Name }</h4>
		<div class="form-group">
			<label>Name</label>
			<input type="text" value={ p.Name } disabled class="disabled-input"/>
			<input type="hidden" name="name" value={ p.Name }/>
		</div>
		<div class="form-group">
			<label for={ "prompt-" + p.Name }>System Prompt</label>
			<textarea id={ "prompt-" + p.Name } name="system_prompt" class="monospace-textarea" rows="6">{ p.SystemPrompt }</textarea>
			<small class="hint">Leave empty to use the default system prompt.</small>
		</div>
		<div class="form-group">
			<label>Injected Skills</label>
			<small class="hint">Skills selected here are automatically loaded into the system prompt when this persona is active.</small>
			<div class="skills-checkbox-group">
				for _, s := range availableSkills {
					<label class="checkbox-label">
						if isSkillSelected(p.InjectedSkills, s.Name) {
							<input type="checkbox" name="injected_skills" value={ s.Name } checked/>
						} else {
							<input type="checkbox" name="injected_skills" value={ s.Name }/>
						}
						<span class="skill-name">{ s.Name }</span>
						if s.Description != "" {
							<span class="skill-desc"> — { s.Description }</span>
						}
					</label>
				}
			</div>
		</div>
		<div class="form-actions">
			<button type="submit" class="btn btn-primary">Save</button>
			<button type="button" class="btn btn-secondary"
				hx-get="/api/personas"
				hx-target="#persona-list"
				hx-swap="innerHTML">
				Cancel
			</button>
			<span id={ "edit-indicator-" + p.Name } class="htmx-indicator">Saving…</span>
		</div>
		<div id="persona-form-errors" class="form-error"></div>
	</form>
}

// PersonaSelector renders a compact dropdown for the header that lists all
// personas and allows switching the active persona.
templ PersonaSelector(personas []*persona.PersonaDefinition, activePersona string) {
	<div id="persona-selector" class="persona-selector">
		<select
			name="active_persona"
			hx-post="/api/personas/activate"
			hx-trigger="change"
			hx-target="#persona-selector"
			hx-swap="outerHTML"
		>
			for _, p := range personas {
				<option value={ p.Name } if p.Name == activePersona { selected }>
					{ p.Name }
				</option>
			}
		</select>
	</div>
}

// previewPrompt returns the first 120 characters or the full prompt if shorter.
func previewPrompt(prompt string) string {
	if prompt == "" {
		return "(no custom prompt — uses default)"
	}
	maxLen := 120
	runes := []rune(prompt)
	if len(runes) <= maxLen {
		return prompt
	}
	return string(runes[:maxLen]) + "…"
}

// isSkillSelected returns true if the given skill name is in the selected list.
func isSkillSelected(selected []string, name string) bool {
	for _, s := range selected {
		if s == name {
			return true
		}
	}
	return false
}
