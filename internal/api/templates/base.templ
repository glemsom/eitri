package templates

import "github.com/glemsom/eitri/internal/session"

templ Base(title string, chatPath string, sessions []*session.UISession, activeID string, currentPath string, workspace string, contextWindow int, reasoningContent string, compactionEnabled bool, contextWarningThreshold int) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title }</title>
			<!-- Static assets are served with an immutable Cache-Control, so
			     every URL carries the asset cache-bust version. The same value
			     is exposed on <body data-asset-version> for the JS islands
			     (eitri-lazy-load.js, eitri-stream.js) so runtime-fetched assets
			     are versioned too. (issue #969) -->
			<link rel="stylesheet" href={ templ.URL(staticAsset("/static/eitri.css")) }/>
			<!-- Fonts are self-hosted (embedded in the binary, served from
			     /static/fonts/*) — no external network requests. The critical
			     latin subsets are preloaded; font-display: swap in eitri.css
			     keeps text visible while they load. (issue #970) -->
			<link rel="preload" href={ templ.URL(staticAsset("/static/fonts/Inter-latin.woff2")) } as="font" type="font/woff2" crossorigin/>
			<link rel="preload" href={ templ.URL(staticAsset("/static/fonts/JetBrainsMono-latin.woff2")) } as="font" type="font/woff2" crossorigin/>
			<!-- Core scripts are non-render-blocking (defer). The heavy rendering
			     libraries (mermaid, KaTeX, Prism) are NOT loaded here — they are
			     fetched on demand by eitri-lazy-load.js only when content that
			     needs them is present. (issue #968) -->
			<script src={ templ.URL(staticAsset("/static/htmx.min.js")) } defer></script>
			<script src={ templ.URL(staticAsset("/static/eitri-session-id.js")) } defer></script>
			<script src={ templ.URL(staticAsset("/static/eitri-stream-common.js")) } defer></script>
			<script src={ templ.URL(staticAsset("/static/eitri-stream-toolcards.js")) } defer></script>
			<script src={ templ.URL(staticAsset("/static/eitri-stream-announcer.js")) } defer></script>
			<script src={ templ.URL(staticAsset("/static/eitri-stream-tokens.js")) } defer></script>
			<script src={ templ.URL(staticAsset("/static/eitri-stream-confirmation.js")) } defer></script>
			<script src={ templ.URL(staticAsset("/static/eitri-stream-scroll.js")) } defer></script>
			<script src={ templ.URL(staticAsset("/static/eitri-stream-render.js")) } defer></script>
			<script src={ templ.URL(staticAsset("/static/eitri-stream.js")) } defer></script>
			<script src={ templ.URL(staticAsset("/static/eitri-composer.js")) } defer></script>
			<script src={ templ.URL(staticAsset("/static/eitri-renderers.js")) } defer></script>
			<script src={ templ.URL(staticAsset("/static/eitri-mermaid.js")) } defer></script>
			<script src={ templ.URL(staticAsset("/static/eitri-persona-selector.js")) } defer></script>
			<script src={ templ.URL(staticAsset("/static/eitri-session-rename.js")) } defer></script>
			<script src={ templ.URL(staticAsset("/static/eitri-settings.js")) } defer></script>
			<script src={ templ.URL(staticAsset("/static/eitri-context.js")) } defer></script>
			<script src={ templ.URL(staticAsset("/static/eitri-resize.js")) } defer></script>
			<script src={ templ.URL(staticAsset("/static/eitri-events.js")) } defer></script>
			<script src={ templ.URL(staticAsset("/static/eitri-lazy-load.js")) } defer></script>
			<link rel="icon" type="image/png" sizes="32x32" href={ templ.URL(staticAsset("/static/favicon-32.png")) }/>
			<link rel="icon" type="image/png" sizes="16x16" href={ templ.URL(staticAsset("/static/favicon-16.png")) }/>
			<!-- PWA meta tags -->
			<meta name="theme-color" content="#1a1a2e" media="(prefers-color-scheme: dark)"/>
			<meta name="theme-color" content="#f5f5f7" media="(prefers-color-scheme: light)"/>
			<meta name="color-scheme" content="light dark"/>
			<meta name="apple-mobile-web-app-capable" content="yes"/>
			<meta name="apple-mobile-web-app-title" content="Eitri"/>
			<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"/>
			<link rel="apple-touch-icon" sizes="192x192" href={ templ.URL(staticAsset("/static/pwa-icon-192.png")) }/>
			<link rel="apple-touch-icon" sizes="512x512" href={ templ.URL(staticAsset("/static/pwa-icon-512.png")) }/>
			<link rel="manifest" href="/manifest.json"/>
			<script>
				if ('serviceWorker' in navigator) {
					navigator.serviceWorker.register('/sw.js', { scope: '/' }).catch(function(err) {
						console.error('Service worker registration failed:', err);
					});
				}
			</script>
		</head>
		<body hx-ext="head-support" data-asset-version={ assetVersion() }>
			<div id="app">
				<header>
					<h1><span class="header-face-container" data-stream-status="idle"><img src={ templ.URL(staticAsset("/static/face.webp")) } alt="" class="header-face" width="28" height="28"/></span><span class="typing-dots" hidden><span>.</span><span>.</span><span>.</span></span> Eitri<span class="stream-status-text idle">Idle</span></h1>
					if activeID != "" {
						<div id="workspace-indicator" class="workspace-indicator" title={ workspace }
							hx-get={ "/api/sessions/" + activeID + "/directory-browser" }
							hx-target="body"
							hx-swap="beforeend"
						>
							Workspace: { pathBase(workspace) }
						</div>
					} else {
						<div id="workspace-indicator" class="workspace-indicator" title={ workspace }>
							Workspace: { pathBase(workspace) }
						</div>
					}
					<div id="persona-selector-container"
						hx-get="/api/personas/selector"
						hx-trigger="load"
						hx-swap="innerHTML">
					</div>
					<div class="dropdown" id="nav-dropdown">
						<button class="gear-btn" title="Menu" aria-label="Menu">
							&#9881;
						</button>
						<div class="dropdown-content">
							@NavLink(chatPath, "Chat", currentPath)
							@NavLink("/sessions", "Sessions", currentPath)
							@NavLink("/settings", "Settings", currentPath)
							@NavLink("/skills", "Skills", currentPath)
						</div>
					</div>
				</header>
				if sessions != nil {
					<div id="sidebar">
					<div class="sidebar-panel" id="session-panel">
						@SessionTabs(sessions, activeID, false)
					</div>
					<div class="sidebar-divider"></div>
					<div class="sidebar-panel" id="tool-activity">
						<div class="sidebar-header"><span class="sidebar-title">Tools</span></div>
						<div class="tool-activity-list"></div>
					</div>
					<div class="sidebar-divider"></div>
					<div class="sidebar-panel" id="context-panel">
						<div class="sidebar-header">
							<span class="sidebar-title">Context</span>
						</div>
						<eitri-context data-context-window="{ contextWindow }" data-warning-threshold="{ contextWarningThreshold }">
						</eitri-context>
						<button
							id="compact-btn"
							class="compact-btn"
							hx-post={ templ.URL("/api/sessions/" + activeID + "/compact") }
							hx-target="#error-toasts"
							hx-swap="beforeend"
						>
							Compact now
						</button>
					</div>
					<div class="sidebar-divider"></div>
					<div class="sidebar-panel" id="thinking-panel">
						<div class="sidebar-header"><span class="sidebar-title">Thinking</span></div>
						<pre class="thinking-content">{ reasoningContent }</pre>
					</div>
				</div>
				} else {
					<div id="sidebar"><div id="session-tabs"></div><div id="tool-activity"><div class="sidebar-header"><span class="sidebar-title">Tools</span></div><div class="tool-activity-list"></div></div><div class="sidebar-divider"></div><div id="context-panel"><div class="sidebar-header"><span class="sidebar-title">Context</span></div><eitri-context data-context-window="{ contextWindow }" data-warning-threshold="{ contextWarningThreshold }"></eitri-context></div><div class="sidebar-divider"></div><div id="thinking-panel"><div class="sidebar-header"><span class="sidebar-title">Thinking</span></div><pre class="thinking-content">{ reasoningContent }</pre></div></div>
				}
				<main>
					<noscript>
						<p>JavaScript is required for Eitri. Please enable JavaScript.</p>
					</noscript>
					{ children... }
				</main>
			</div>
		</body>
	</html>
}

templ NavLink(path string, label string, currentPath string) {
	<a
		href={ templ.URL(path) }
		hx-get={ templ.URL(path) }
		hx-target="#app"
		hx-select="#app"
		hx-swap="outerHTML"
		hx-push-url="true"
		class={ "nav-link", templ.KV("active", path == currentPath) }
	>{ label }</a>
}

// ChatPage renders the full chat page layout with session sidebar and chat view.
templ ChatPage(sessions []*session.UISession, activeID string, sess *session.UISession, workspace string, configValid bool, currentPath string, contextWindow int, reasoningContent string, userEmail string, compactionEnabled bool, contextWarningThreshold int, contextFiles []session.ContextFile) {
	@Base("Eitri — Chat", "/sessions/"+activeID, sessions, activeID, currentPath, workspace, contextWindow, reasoningContent, compactionEnabled, contextWarningThreshold) {
		@ChatView(sess, configValid, userEmail, contextFiles)
	}
}
