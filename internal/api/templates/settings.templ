package templates

import "github.com/glemsom/eitri/internal/config"

templ SettingsView(cfg *config.Config, models []string, workspace string, chatPath string, currentPath string, contextWindow int, bwrapAvailable bool, supportedLevels []string) {
	@Base("Eitri — Settings", chatPath, nil, "", currentPath, workspace, contextWindow, "", false, 75) {
		@SettingsForm(cfg, models, "", "", nil, "", bwrapAvailable, supportedLevels)
	}
}

templ SettingsForm(cfg *config.Config, models []string, errorMessage string, noticeMessage string, deviceFlow *CopilotDeviceFlowView, successMessage string, bwrapAvailable bool, supportedLevels []string) {
	<div id="settings-form" class="settings-view">
		if errorMessage != "" {
			@ErrorToast(errorMessage)
		}
		if successMessage != "" {
			<div class="save-success">{ successMessage }</div>
		}
		if noticeMessage != "" {
			<p class="hint">{ noticeMessage }</p>
		}
		<form id="settings-config-form" hx-put="/api/config" hx-target="#settings-form" hx-swap="outerHTML">
			@profileSection(cfg)
			@providerSection(cfg, deviceFlow)
			@modelSection(cfg, models, supportedLevels)
			@promptSection(cfg)
			@limitsSection(cfg)
			@compactionSection(cfg)
			@sandboxSection(cfg, bwrapAvailable)
			@diagnosticsSection(cfg)
			@browserSection(cfg)

			<div class="form-actions form-actions-sticky">
				<button type="submit" id="settings-save-btn" disabled>Save</button>
				<button type="button" id="settings-revert-btn" disabled>Revert</button>
				<span id="settings-dirty-indicator" class="settings-dirty-indicator" hidden>Unsaved changes</span>
				<div id="test-connection-wrapper" class="test-connection-wrapper">
					<button type="button" id="test-connection-btn" hx-get="/api/models" hx-include="closest form" hx-target="#test-connection-result" hx-swap="innerHTML">Test Connection</button>
					<div id="test-connection-result" class="test-connection-result"></div>
				</div>
				<span class="save-hint">(Ctrl+Enter to save)</span>
			</div>
		</form>

		<!-- Personas section — outside the config form to avoid nested forms -->
		<details class="settings-details">
			<summary><span>Personas</span></summary>
			<div id="persona-section">
				<p class="text-muted">Personas define the system prompt and skills for the agent.</p>
				<div id="persona-list"
					hx-get="/api/personas"
					hx-trigger="load"
					hx-swap="innerHTML">
					<p class="text-muted">Loading personas…</p>
				</div>
				<div class="form-actions">
					<button type="button" class="btn btn-primary"
						hx-get="/api/personas/add-form"
						hx-target="#persona-add-area"
						hx-swap="innerHTML">
						+ Add Persona
					</button>
				</div>
				<div id="persona-add-area"></div>
				<div id="persona-form-errors" class="form-error"></div>
			</div>
		</details>
	</div>
}

templ TestConnectionResult(success bool, message string) {
	if success {
		<span class="connection-ok">&#10003; { message }</span>
	} else {
		<span class="connection-err">{ message }</span>
	}
}
