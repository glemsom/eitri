package templates

import "github.com/glemsom/eitri/internal/config"

templ SettingsView(cfg *config.Config, models []string, workspace string, chatPath string, currentPath string, contextWindow int, bwrapAvailable bool, supportedLevels []string) {
	@Base("Eitri — Settings", chatPath, nil, "", currentPath, workspace, contextWindow, "", false, 75) {
		@SettingsForm(cfg, models, "", "", nil, "", bwrapAvailable, supportedLevels)
	}
}

templ SettingsForm(cfg *config.Config, models []string, errorMessage string, noticeMessage string, deviceFlow *CopilotDeviceFlowView, successMessage string, bwrapAvailable bool, supportedLevels []string) {
	<div id="settings-form" class="settings-view">
		if errorMessage != "" {
			@ErrorToast(errorMessage)
		}
		if successMessage != "" {
			<div class="save-success">{ successMessage }</div>
		}
		if noticeMessage != "" {
			<p class="hint">{ noticeMessage }</p>
		}
		<form hx-put="/api/config" hx-target="#settings-form" hx-swap="outerHTML">
			<details class="settings-details">
				<summary><span>Profile</span></summary>

				<div class="form-group">
					<label for="user_email">Email (used for Gravatar avatar lookup only)</label>
					<input type="email" id="user_email" name="user_email" value={ cfg.UserEmail } placeholder="you@example.com" autocomplete="email"/>
					<small class="hint">Only used to display your Gravatar avatar in chat bubbles. Your email is never shared.</small>
				</div>
			</details>

			<details class="settings-details" open>
				<summary><span>Provider &amp; Authentication</span></summary>

				<div class="form-group">
					<label for="provider">Provider</label>
					<select id="provider" name="provider" required>
						<option value="opencode_go" if cfg.Provider == "opencode_go" { selected }>OpenCode Go</option>
						<option value="github_copilot" if cfg.Provider == "github_copilot" { selected }>GitHub Copilot</option>
						<option value="custom_openai" if cfg.Provider == "custom_openai" { selected }>Custom OpenAI (advanced/best-effort)</option>
					</select>
				</div>

				<div class={ "form-group", "base-url-group", templ.KV("base-url-hidden", cfg.Provider != "custom_openai") }>
					<label for="base_url">Base URL <span if cfg.Provider == "custom_openai" { class="required-marker" }>*</span></label>
					<input type="url" id="base_url" name="base_url" value={ cfg.BaseURL } placeholder="https://opencode.ai/zen/go/v1" required/>
				</div>

				<div class="form-group">
					<label for="api_key">API key / token</label>
					<div class="api-key-row">
						<input type="password" id="api_key" name="api_key" value={ cfg.APIKey } placeholder="API key or bearer token" autocomplete="off"/>
						<label class="checkbox-label">
							<input type="checkbox" name="clear_api_key" value="true"/>
							Clear stored credential
						</label>
					</div>
					<small class="hint">OpenCode Go: API key required. GitHub Copilot: bearer token required. Custom OpenAI: credentials optional.</small>
				</div>

				<div class="device-flow-section">
					if deviceFlow != nil {
						<div class="device-flow-panel">
							<p>Authenticate with GitHub device flow.</p>
							<p class="device-flow-code-wrapper">Open <a href={ deviceFlow.VerificationURI } target="_blank" rel="noreferrer noopener">{ deviceFlow.VerificationURI }</a> and enter code <code class="device-flow-code">{ deviceFlow.UserCode }</code>.</p>
							<div id={ "copilot-device-flow-status-" + deviceFlow.ID } hx-get={ deviceFlow.PollURL } hx-trigger={ deviceFlow.PollTrigger } hx-target="#settings-form" hx-swap="outerHTML">
								<small class="hint">Waiting for GitHub approval…</small>
							</div>
							<div class="form-actions">
								<button type="button" hx-delete={ deviceFlow.CancelURL } hx-target="#settings-form" hx-swap="outerHTML">Cancel GitHub auth</button>
							</div>
						</div>
					} else {
						<div class="device-flow-panel">
							<div class="form-actions">
								<button type="button" hx-post="/api/providers/github_copilot/device-flow/start" hx-include="closest form" hx-target="#settings-form" hx-swap="outerHTML">Authenticate with GitHub</button>
							</div>
							<small class="hint">For GitHub Copilot. Select provider above, start device flow, then models refresh automatically.</small>
						</div>
					}
				</div>
			</details>

			<details class="settings-details">
				<summary><span>Model <span id="model-refresh-spinner" class="model-refresh-spinner" style="visibility:hidden;">&#9696;</span></span></summary>

				<div class="form-group">
					<select id="model" name="model" hx-put="/api/config" hx-trigger="change" hx-target="#settings-form" hx-swap="outerHTML">
						<option value="" disabled selected={ cfg.Model == "" }>Select a model...</option>
						for _, m := range models {
							<option value={ m } if cfg.Model == m { selected }>{ m }</option>
						}
					</select>
					<small class="hint">Models are discovered from current provider settings on load and save.</small>
				</div>

				<div class="form-group">
					<label for="thinking_level">Thinking Level</label>
					<select id="thinking_level" name="thinking_level">
						<option value="" if cfg.ThinkingLevel == "" { selected }>Default (off)</option>
						if len(supportedLevels) > 0 {
							for _, level := range supportedLevels {
								<option value={ level } if cfg.ThinkingLevel == level { selected }>{ capitalize(level) }</option>
							}
						}
					</select>
					<small class="hint">Controls reasoning depth. Supported by DeepSeek, O-series, and other reasoning models. Requires provider support.</small>
				</div>
			</details>

			<details class="settings-details">
				<summary><span>Prompt — { len(cfg.SystemPrompt) } / 4096 chars</span></summary>

				<div class="form-group">
					<label for="system_prompt">System Prompt (session override)</label>
					<textarea id="system_prompt" name="system_prompt" class="monospace-textarea" rows="8" placeholder="Leave empty to use the active persona's prompt.">{ cfg.SystemPrompt }</textarea>
					<div class="char-count-wrapper">
						<small class="char-count" id="prompt-char-count">{ len(cfg.SystemPrompt) } / 4096 chars</small>
					</div>
					<small class="hint">Leave empty to use the active persona's prompt. This overrides the persona's system prompt for all sessions.</small>
				</div>
			</details>

			<details class="settings-details">
				<summary><span>Timeouts &amp; Limits</span></summary>

				<div class="form-group">
					<label for="session_timeout">Session Timeout (seconds)</label>
					<input type="number" id="session_timeout" name="session_timeout" value={ cfg.SessionTimeout / 1_000_000_000 } min="60" required/>
				</div>

				<div class="form-group">
					<label for="command_timeout">Command Timeout (seconds)</label>
					<input type="number" id="command_timeout" name="command_timeout" value={ cfg.CommandTimeout / 1_000_000_000 } min="1" required/>
				</div>

				<div class="form-group">
					<label for="max_turns">Max Turns</label>
					<input type="number" id="max_turns" name="max_turns" value={ cfg.MaxTurns } min="1" required/>
				</div>

				<div class="form-group">
					<label for="context_window_tokens">Context Window Tokens</label>
					<div class="context-window-row">
						<input type="number" id="context_window_tokens" name="context_window_tokens" value={ cfg.ContextWindowTokens } min="1024" required/>
						<span class="context-window-source">
							if cfg.ContextWindowOverridden {
								&#128295; manual
							} else {
								&#128200; auto
							}
						</span>
					</div>
				</div>
			</details>

			<details class="settings-details">
				<summary><span>Compaction</span></summary>

				<div class="form-group">
					<label class="checkbox-label">
						<input type="checkbox" id="compaction_enabled" name="compaction_enabled" value="true" if cfg.CompactionEnabled { checked }/>
						Enable auto-compaction
					</label>
					<input type="hidden" name="compaction_enabled" value="false"/>
					<small class="hint">Automatically compact session history when context window usage exceeds the high-water threshold. Reduces history to the low-water mark.</small>
				</div>

				<div class="form-group">
					<label for="compaction_threshold_percent">High-water threshold (%)</label>
					<div class="range-wrapper">
						<input type="range" id="compaction_threshold_percent" name="compaction_threshold_percent" value={ cfg.CompactionThresholdPercent } min="50" max="100" class="range-input" oninput="document.getElementById('compaction_threshold_display').textContent = this.value"/>
						<span id="compaction_threshold_display" class="range-value">{ cfg.CompactionThresholdPercent }%</span>
					</div>
					<small class="hint">When context window usage reaches this percentage, compaction triggers (50–100).</small>
				</div>

				<div class="form-group">
					<label for="compaction_low_water_percent">Low-water mark (%)</label>
					<div class="range-wrapper">
						<input type="range" id="compaction_low_water_percent" name="compaction_low_water_percent" value={ cfg.CompactionLowWaterPercent } min="10" max="60" class="range-input" oninput="document.getElementById('compaction_low_water_display').textContent = this.value"/>
						<span id="compaction_low_water_display" class="range-value">{ cfg.CompactionLowWaterPercent }%</span>
					</div>
					<small class="hint">History is compacted down to this percentage of the context window (10–60). Must be less than the high-water threshold.</small>
				</div>

				<div class="form-group">
					<label for="compaction_tool_call_retention_turns">Tool call retention (turns)</label>
					<div class="range-wrapper">
						<input type="range" id="compaction_tool_call_retention_turns" name="compaction_tool_call_retention_turns" value={ cfg.CompactionToolCallRetentionTurns } min="0" max="50" class="range-input" oninput="document.getElementById('compaction_tool_call_retention_display').textContent = this.value"/>
						<span id="compaction_tool_call_retention_display" class="range-value">{ cfg.CompactionToolCallRetentionTurns }</span>
					</div>
					<small class="hint">Number of recent assistant messages whose tool-call arguments are preserved. Older messages have arguments pruned to save tokens (0 = disable pruning).</small>
				</div>

				<div class="form-group">
					<label class="checkbox-label">
						<input type="checkbox" id="compaction_salience_enabled" name="compaction_salience_enabled" value="true" if cfg.CompactionSalienceEnabled { checked }/>
						Enable salience-based compaction ordering
					</label>
					<input type="hidden" name="compaction_salience_enabled" value="false"/>
					<small class="hint">When enabled, important messages (errors, stack traces) are preserved longer during compaction. When disabled, the oldest messages are compacted first regardless of importance.</small>
				</div>
			</details>

			<details class="settings-details">
				<summary>
					<span>Sandbox</span>
					<span class="sandbox-badge">@templ.Raw(sandboxBadge(string(cfg.Sandbox.Profile), bwrapAvailable))</span>
				</summary>

				<div class="form-group">
					<label class="checkbox-label">
						<input type="checkbox" id="sandbox_enabled" name="sandbox_enabled" value="true" if cfg.Sandbox.Profile == "default" { checked }/>
						Enable sandbox (requires bwrap)
					</label>
					<input type="hidden" name="sandbox_enabled" value="false"/>
					<small class="hint">Wraps shell commands in a bubblewrap sandbox. Disable if you experience compatibility issues.</small>
				</div>

				<div class="form-group">
					<label for="sandbox_extra_writable_paths">Extra writable paths</label>
					<textarea id="sandbox_extra_writable_paths" name="sandbox_extra_writable_paths" class="monospace-textarea" rows="3" placeholder="/opt/toolchain&#10;/var/cache/build">{ joinSandboxPaths(cfg.Sandbox.ExtraWritablePaths) }</textarea>
					<small class="hint">Additional directories to make read-write inside the sandbox (one per line).</small>
				</div>
			</details>

			<details class="settings-details">
				<summary><span>Debug &amp; Diagnostics</span></summary>

				<div class="form-group">
					<label class="checkbox-label">
						<input type="checkbox" id="debug_prompt" name="debug_prompt" value="true" if cfg.DebugPrompt { checked }/>
						<input type="hidden" name="debug_prompt" value="false"/>
						Debug prompt logging
					</label>
					<small class="hint">Log full LLM request payloads (was <code>EITRI_DEBUG_PROMPT=1</code>).</small>
				</div>

				<div class="form-group">
					<label class="checkbox-label">
						<input type="checkbox" id="debug_request" name="debug_request" value="true" if cfg.DebugRequest { checked }/>
						<input type="hidden" name="debug_request" value="false"/>
						Debug request logging
					</label>
					<small class="hint">Log full LLM request/response payloads (was <code>EITRI_DEBUG_REQUEST=1</code>).</small>
				</div>

				<div class="form-group">
					<label for="debug_llm_dir">LLM debug output directory</label>
					<input type="text" id="debug_llm_dir" name="debug_llm_dir" value={ cfg.DebugLLMDir } placeholder="/tmp/eitri-llm-debug"/>
					<small class="hint">Directory to write debug logs on LLM errors (was <code>EITRI_DEBUG_LLM_DIR</code>).</small>
				</div>
			</details>

			<details class="settings-details">
				<summary><span>Browser</span></summary>

				<div class="form-group">
					<label for="browser_ws_url">Browser WebSocket URL</label>
					<input type="url" id="browser_ws_url" name="browser_ws_url" value={ cfg.BrowserWsUrl } placeholder="ws://127.0.0.1:9222"/>
					<small class="hint">Start Chrome with <code>google-chrome --remote-debugging-port=9222</code> to enable browser tool access.</small>
				</div>
			</details>

			<div class="form-actions form-actions-sticky">
				<button type="submit">Save</button>
				<div id="test-connection-wrapper" class="test-connection-wrapper">
					<button type="button" id="test-connection-btn" hx-get="/api/models" hx-include="closest form" hx-target="#test-connection-result" hx-swap="innerHTML">Test Connection</button>
					<div id="test-connection-result" class="test-connection-result"></div>
				</div>
				<span class="save-hint">(Ctrl+Enter to save)</span>
			</div>
		</form>

		<!-- Personas section — outside the config form to avoid nested forms -->
		<details class="settings-details">
			<summary><span>Personas</span></summary>
			<div id="persona-section">
				<p class="text-muted">Personas define the system prompt and skills for the agent.</p>
				<div id="persona-list"
					hx-get="/api/personas"
					hx-trigger="load"
					hx-swap="innerHTML">
					<p class="text-muted">Loading personas…</p>
				</div>
				<div class="form-actions">
					<button type="button" class="btn btn-primary"
						hx-get="/api/personas/add-form"
						hx-target="#persona-add-area"
						hx-swap="innerHTML">
						+ Add Persona
					</button>
				</div>
				<div id="persona-add-area"></div>
				<div id="persona-form-errors" class="form-error"></div>
			</div>
		</details>
	</div>
}

templ TestConnectionResult(success bool, message string) {
	if success {
		<span class="connection-ok">&#10003; { message }</span>
	} else {
		<span class="connection-err">{ message }</span>
	}
}
